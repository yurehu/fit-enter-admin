generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== 生徒管理 =====

model Student {
  id            String   @id @default(cuid())
  name          String
  grade         String
  parentEmail   String
  qrToken       String   @unique @default(uuid())
  schoolId      String?
  targetSchools String?
  lineUserId    String?
  notes         String?
  createdAt     DateTime @default(now())

  school           School?           @relation(fields: [schoolId], references: [id])
  attendances      Attendance[]
  enrollments      ClassEnrollment[]
  classAttendances ClassAttendance[]
  examResults      ExamResult[]

  @@index([schoolId])
}

// ===== 出席管理 =====

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  type      String
  timestamp DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([timestamp])
}

// ===== 管理者 =====

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  pin       String?
  createdAt DateTime @default(now())
}

// ===== 授業管理 =====

model WeeklyClass {
  id        String   @id @default(cuid())
  title     String
  weekday   Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  enrollments ClassEnrollment[]
  attendances ClassAttendance[]
}

model ClassEnrollment {
  id            String @id @default(cuid())
  weeklyClassId String
  studentId     String

  weeklyClass WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([weeklyClassId, studentId])
}

model ClassAttendance {
  id            String   @id @default(cuid())
  weeklyClassId String
  studentId     String
  date          String
  status        String   @default("present")
  createdAt     DateTime @default(now())

  weeklyClass WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([weeklyClassId, studentId, date])
}

// ===== 学校マスタ =====

model School {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  createdAt DateTime @default(now())

  students Student[]
}

// ===== 成績管理 =====

model ExamResult {
  id        String   @id @default(cuid())
  studentId String
  subject   String
  score     Int
  maxScore  Int      @default(100)
  examName  String
  examDate  String
  notes     String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([examDate])
}

// ===== 監査ログ =====

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  adminId    String?
  adminEmail String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
