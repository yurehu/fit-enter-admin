generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== 生徒管理 =====

model Student {
  id            String   @id @default(cuid())
  name          String
  grade         String
  parentEmail   String
  qrToken       String   @unique @default(uuid())
  schoolId      String?
  targetSchools String? // JSON配列: ["松山東高校", "愛光高校"]
  lineUserId    String? // LINE連携用（将来用）
  notes         String? // メモ欄
  createdAt     DateTime @default(now())

  school           School?           @relation(fields: [schoolId], references: [id])
  attendances      Attendance[]
  enrollments      ClassEnrollment[]
  classAttendances ClassAttendance[]
  examResults      ExamResult[]
}

// ===== 出席管理 =====

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  type      String // "checkin" | "checkout"
  timestamp DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([timestamp])
}

// ===== 管理者 =====

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  pin       String? // bcryptハッシュ化された4桁PINコード
  createdAt DateTime @default(now())
}

// ===== 授業管理 =====

model WeeklyClass {
  id        String   @id @default(cuid())
  title     String
  weekday   Int // 0=日曜 ... 6=土曜
  startTime String // "HH:mm" 形式
  endTime   String // "HH:mm" 形式
  createdAt DateTime @default(now())

  enrollments ClassEnrollment[]
  attendances ClassAttendance[]
}

model ClassEnrollment {
  id            String @id @default(cuid())
  weeklyClassId String
  studentId     String

  weeklyClass WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([weeklyClassId, studentId])
}

model ClassAttendance {
  id            String   @id @default(cuid())
  weeklyClassId String
  studentId     String
  date          String // "YYYY-MM-DD" 形式
  status        String   @default("present")
  createdAt     DateTime @default(now())

  weeklyClass WeeklyClass @relation(fields: [weeklyClassId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([weeklyClassId, studentId, date])
}

// ===== 学校マスタ =====

model School {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String // "小学校" | "中学校" | "高校" | "その他"
  createdAt DateTime @default(now())

  students Student[]
}

// ===== 成績管理 =====

model ExamResult {
  id        String   @id @default(cuid())
  studentId String
  subject   String // "数学", "英語" 等
  score     Int
  maxScore  Int      @default(100)
  examName  String // "第1回模試", "中間テスト" 等
  examDate  String // "YYYY-MM-DD"
  notes     String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ===== 監査ログ =====

model AuditLog {
  id         String   @id @default(cuid())
  action     String // "LOGIN_SUCCESS", "STUDENT_CREATE" 等
  adminId    String?
  adminEmail String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())
}
